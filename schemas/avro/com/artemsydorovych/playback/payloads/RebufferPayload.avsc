{
  "type": "record",
  "name": "RebufferPayload",
  "namespace": "com.artemsydorovych.playback.avro",
  "doc": "Payload for REBUFFER_START and REBUFFER_END events",
  "fields": [
    {
      "name": "bufferLength",
      "type": "long",
      "doc": "Buffer length when rebuffering started (milliseconds)"
    },
    {
      "name": "rebufferDuration",
      "type": ["null", "long"],
      "default": null,
      "doc": "Duration of rebuffering (milliseconds, only populated for REBUFFER_END)"
    },
    {
      "name": "bandwidthEstimate",
      "type": "int",
      "doc": "Current bandwidth estimate (kbps)"
    },
    {
      "name": "networkType",
      "type": ["null", "string"],
      "default": null,
      "doc": "Network type (wifi, cellular, ethernet)"
    }
  ]
}
