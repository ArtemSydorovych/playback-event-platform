# Base Dockerfile for Flink jobs with S3 and Prometheus support
# This is used as a base for all job-specific Dockerfiles

FROM flink:1.18-java17

# Download and install S3 filesystem plugin for checkpoint storage
RUN mkdir -p /opt/flink/plugins/s3-fs-hadoop && \
    curl -fsSL https://repo1.maven.org/maven2/org/apache/flink/flink-s3-fs-hadoop/1.18.1/flink-s3-fs-hadoop-1.18.1.jar \
    -o /opt/flink/plugins/s3-fs-hadoop/flink-s3-fs-hadoop-1.18.1.jar

# Copy the job JAR
COPY flink-jobs/build/libs/playback-flink-jobs-all.jar /opt/flink/usrlib/

# Default Flink configuration for Netflix-style production
ENV FLINK_PROPERTIES="\
jobmanager.rpc.address: localhost\n\
state.backend: rocksdb\n\
state.backend.incremental: true\n\
execution.checkpointing.interval: 60000\n\
execution.checkpointing.mode: EXACTLY_ONCE\n\
metrics.reporters: prometheus\n\
metrics.reporter.prometheus.factory.class: org.apache.flink.metrics.prometheus.PrometheusReporterFactory\n\
metrics.reporter.prometheus.port: 9249\n\
"

# Expose ports
# 8081 - Web UI
# 6123 - RPC
# 9249 - Prometheus metrics
EXPOSE 8081 6123 9249

ENTRYPOINT ["/docker-entrypoint.sh"]
